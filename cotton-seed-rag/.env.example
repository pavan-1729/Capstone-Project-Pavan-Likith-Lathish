# Cotton Seed RAG System - Environment Configuration

# ==========================================
# Google Gemini API (for cloud LLM)
# ==========================================
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# System Settings
# ==========================================
# Maximum number of candidates to pass to LLM
MAX_CANDIDATES=30

# Number of top recommendations to return
TOP_K_RECOMMENDATIONS=5
