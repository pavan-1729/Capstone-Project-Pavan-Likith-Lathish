# Maize Seed RAG System - Environment Configuration

# ==========================================
# LLM Backend Selection
# ==========================================
# Options: gemini, firebase
LLM_BACKEND=firebase

# ==========================================
# Google Gemini API (for cloud LLM)
# ==========================================
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Firebase Configuration (for local LLM)
# ==========================================
# Get these from Firebase Console: https://console.firebase.google.com/

# Firebase Realtime Database URL
# Example: https://your-project-id-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=https://seedhybridadvisory-default-rtdb.asia-southeast1.firebasedatabase.app/

# Path to Firebase service account key JSON file
# Download from: Firebase Console > Project Settings > Service accounts
FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\gangi\OneDrive\Desktop\Capstone Project\maize-seed-rag\serviceAccountKey.json

# Firebase LLM Client Settings (optional)
# Set to very high value for unlimited waiting
# 300 = 5 minutes, 3600 = 1 hour, 86400 = 24 hours
FIREBASE_MAX_WAIT_TIME=86400  # Maximum seconds to wait for response
FIREBASE_POLL_INTERVAL=3.0   # Check interval in seconds (2-5 recommended)

# ==========================================
# System Settings
# ==========================================
# Maximum number of candidates to pass to LLM
MAX_CANDIDATES=30

# Number of top recommendations to return
TOP_K_RECOMMENDATIONS=5
