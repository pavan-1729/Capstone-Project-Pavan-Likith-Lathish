<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night mode theme - uses same green palette -->
    <style name="Theme.SeedAdviosory" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.SeedAdviosory.Splash" parent="Theme.SeedAdviosory">
        <item name="android:windowBackground">@drawable/bg_splash_gradient</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.SeedAdviosory.Auth" parent="Theme.SeedAdviosory">
        <item name="android:statusBarColor">@color/primary_dark</item>
    </style>
</resources>