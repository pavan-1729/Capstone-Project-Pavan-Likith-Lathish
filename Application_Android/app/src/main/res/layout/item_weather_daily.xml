<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_xs"
    android:layout_marginBottom="@dimen/spacing_xs"
    android:background="@drawable/bg_option_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_sm">

    <!-- Day and Date -->
    <LinearLayout
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_daily_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_daily_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oct 08"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Condition icon & description -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xs"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_daily_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⛅"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_daily_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xs"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Partly Cloudy"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- Rain Chance Badge -->
    <TextView
        android:id="@+id/tv_daily_rain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:background="@drawable/bg_option_card"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="💧 15%"
        android:textColor="@color/info"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Min - Max Temp -->
    <TextView
        android:id="@+id/tv_daily_temps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="24° / 35°"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />
</LinearLayout>
