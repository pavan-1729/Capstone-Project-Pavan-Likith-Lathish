<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            app:backgroundTint="@null"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/about_title"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Title & Branding Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="@dimen/card_elevation"
                android:radius="@dimen/card_radius">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_weather_card"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌱 Farmer-Aware"
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/text_headline"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/project_full_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_about_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:textColor="@color/text_hint"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Objective Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:elevation="@dimen/card_elevation"
                android:radius="@dimen/card_radius">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 Project Objective"
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/project_objective"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Knowledge Sources Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:elevation="@dimen/card_elevation"
                android:radius="@dimen/card_radius">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚 Authoritative Knowledge Sources"
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:lineSpacingExtra="3dp"
                        android:text="• Indian Council of Agricultural Research (ICAR)\n• ICAR - Indian Institute of Maize Research (IIMR), Ludhiana\n• All India Coordinated Research Project (AICRP) on Maize\n• State Agricultural Universities (SAUs) release notifications\n• Directorate of Plant Protection, Quarantine &amp; Storage"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Technical Stack Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:elevation="@dimen/card_elevation"
                android:radius="@dimen/card_radius">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️ Technical Architecture"
                        android:textColor="@color/primary_dark"
                        android:textSize="@dimen/text_subtitle"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:lineSpacingExtra="3dp"
                        android:text="• Native Android (Java + MVVM + XML)\n• Retrieval-Augmented Generation (RAG) Architecture\n• Multi-Lingual Architecture (English, Telugu, Tamil, Hindi)\n• Retrofit REST Clients with Offline ICAR Knowledge Base\n• Farmer-Centric UI &amp; Responsible Agricultural Disclaimers"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Interactive Buttons -->
            <Button
                android:id="@+id/btn_how_it_works"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@null"
                android:text="@string/how_system_works"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_subtitle" />

            <!-- Disclaimer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:background="@drawable/bg_option_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📋 Responsible AI Notice"
                    android:textColor="@color/primary_dark"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/disclaimer_expert"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
