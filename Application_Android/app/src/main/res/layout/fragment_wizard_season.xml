<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/tv_when_grow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/when_grow_maize"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/card_kharif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:background="@drawable/bg_option_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">
            <TextView
                android:id="@+id/tv_kharif_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/season_kharif" android:textColor="@color/text_primary"
                android:textSize="@dimen/text_subtitle" android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_kharif_desc"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" android:text="@string/season_kharif_desc"
                android:textColor="@color/text_secondary" android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_rabi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_option_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">
            <TextView
                android:id="@+id/tv_rabi_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/season_rabi" android:textColor="@color/text_primary"
                android:textSize="@dimen/text_subtitle" android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_rabi_desc"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" android:text="@string/season_rabi_desc"
                android:textColor="@color/text_secondary" android:textSize="@dimen/text_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_spring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_option_card"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">
            <TextView
                android:id="@+id/tv_spring_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/season_spring" android:textColor="@color/text_primary"
                android:textSize="@dimen/text_subtitle" android:textStyle="bold" />
            <TextView
                android:id="@+id/tv_spring_desc"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" android:text="@string/season_spring_desc"
                android:textColor="@color/text_secondary" android:textSize="@dimen/text_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
