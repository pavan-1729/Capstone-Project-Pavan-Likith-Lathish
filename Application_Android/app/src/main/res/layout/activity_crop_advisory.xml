<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            app:backgroundTint="@null"
            android:text="←"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/advisories_label"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Subtitle Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_weather_card"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌽 Seasonal Crop Management Advisory"
            android:textColor="@color/primary_dark"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Timely agronomic recommendations for maize cultivation based on current weather and growth stages."
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- Category Filters ScrollView -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_sm"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingEnd="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_xs"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_filter_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:background="@drawable/bg_button_primary"
                app:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="All Advisories"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_irrigation"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:background="@drawable/bg_button_secondary"
                app:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="💧 Water"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_fertilizer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:background="@drawable/bg_button_secondary"
                app:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="🧪 Fertilizer"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_pest"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:background="@drawable/bg_button_secondary"
                app:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="🐛 Pests"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/chip_disease"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:background="@drawable/bg_button_secondary"
                app:backgroundTint="@null"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="🌿 Disease"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Advisory List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/layout_advisories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md" />
    </ScrollView>
</LinearLayout>
