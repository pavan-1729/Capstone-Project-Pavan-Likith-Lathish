<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:gravity="center_horizontal"
        android:orientation="vertical"

        android:padding="@dimen/spacing_lg">

        <!-- Back -->

        <Button
            android:id="@+id/btn_back"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_gravity="start"

            android:background="?attr/selectableItemBackground"

            android:text="← Back"
            android:textAllCaps="false"

            android:textColor="@color/primary"

            app:backgroundTint="@null" />

        <!-- Icon -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_xl"

            android:text="🔐"
            android:textSize="56sp" />

        <!-- Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_md"

            android:text="@string/forgot_password_title"

            android:textColor="@color/text_primary"

            android:textSize="@dimen/text_headline"

            android:textStyle="bold" />

        <!-- Description -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_sm"

            android:gravity="center"

            android:text="Enter your registered email address and we will send you a password reset link."

            android:textColor="@color/text_secondary"

            android:textSize="@dimen/text_body" />

        <!-- Email -->

        <com.google.android.material.textfield.TextInputLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_xl"

            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText

                android:id="@+id/et_forgot_email"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="Email address"

                android:inputType="textEmailAddress"

                android:textSize="@dimen/text_subtitle" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Send Reset Link -->

        <Button
            android:id="@+id/btn_send_reset"

            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"

            android:layout_marginTop="@dimen/spacing_lg"

            android:background="@drawable/bg_button_primary"

            android:text="Send Reset Link"

            android:textAllCaps="false"

            android:textColor="@color/white"

            android:textSize="@dimen/text_subtitle"
            app:backgroundTint="@null" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/spacing_md"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <!-- Information -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="@dimen/spacing_lg"

            android:gravity="center"

            android:text="After receiving the email, open the link and create a new password."

            android:textColor="@color/text_hint"

            android:textSize="@dimen/text_caption" />

    </LinearLayout>

</ScrollView>